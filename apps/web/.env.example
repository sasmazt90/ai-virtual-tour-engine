# App
APP_URL=http://localhost:4000
AUTH_URL=http://localhost:4000
AUTH_SECRET=replace-with-a-random-32-byte-secret
CORS_ORIGINS=http://localhost:4000

# Database
# Supabase: use the pooled connection string from Project Settings > Database.
DATABASE_URL=postgres://user:password@localhost:5432/360_estate_suite
