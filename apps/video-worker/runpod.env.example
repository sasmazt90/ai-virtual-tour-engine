DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=uploads
VIDEO_UPLOAD_S3_ENDPOINT=https://s3api-YOUR_DATACENTER.runpod.io
VIDEO_UPLOAD_S3_REGION=YOUR_DATACENTER
VIDEO_UPLOAD_S3_BUCKET=YOUR_NETWORK_VOLUME_ID
VIDEO_UPLOAD_S3_ACCESS_KEY_ID=YOUR_RUNPOD_S3_ACCESS_KEY
VIDEO_UPLOAD_S3_SECRET_ACCESS_KEY=YOUR_RUNPOD_S3_SECRET_ACCESS_KEY
WORKER_POLL_SECONDS=10
FRAME_RATE=4
MAX_IMAGE_SIZE=1600
SPLAT_ITERATIONS=10000
SPLAT_DENSIFY_GRAD_THRESH=0.00012
MIN_REGISTERED_IMAGES=90
MIN_REGISTERED_IMAGE_RATIO=0.5
MIN_SPARSE_POINTS=14000
MIN_SPLAT_COUNT=70000
MAX_SCENE_FRAMES=360
EXHAUSTIVE_MATCH_MAX_FRAMES=220
