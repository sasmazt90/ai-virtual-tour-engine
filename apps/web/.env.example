# Supabase Storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# OpenAI
OPEN_AI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_KEY=

# Optional
GOOGLE_MAPS_API_KEY=
PDF_SERVICE_URL=
NEXT_PUBLIC_CREATE_ENV=PRODUCTION
