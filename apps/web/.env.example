# App
APP_URL=http://localhost:4000
AUTH_URL=http://localhost:4000
AUTH_SECRET=replace-with-a-random-32-byte-secret
CORS_ORIGINS=http://localhost:4000

# Database
# Supabase: use the pooled connection string from Project Settings > Database.
DATABASE_URL=postgres://user:password@localhost:5432/360_estate_suite
DATABASE_SSL=true

# Supabase Storage
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=uploads

# Optional: S3-compatible storage for large source videos.
# Use this for RunPod Network Volume S3 so uploads do not hit Supabase object limits.
VIDEO_UPLOAD_S3_ENDPOINT=
VIDEO_UPLOAD_S3_REGION=
VIDEO_UPLOAD_S3_BUCKET=
VIDEO_UPLOAD_S3_ACCESS_KEY_ID=
VIDEO_UPLOAD_S3_SECRET_ACCESS_KEY=
VIDEO_UPLOAD_S3_PUBLIC_BASE_URL=
VIDEO_UPLOAD_S3_SIGNED_GET_EXPIRES_SECONDS=604800

# OpenAI
OPEN_AI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_KEY=

# Optional
GOOGLE_MAPS_API_KEY=
PDF_SERVICE_URL=
NEXT_PUBLIC_CREATE_ENV=PRODUCTION
